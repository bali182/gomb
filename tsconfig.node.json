{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node", "electron-vite/node"],
    "noEmit": true
  },
  "include": [
    "vite.config.ts",
    "vite.common.ts",
    "electron.vite.config.ts",
    "electron-builder.config.ts",
    "src/electron/electron-api/**/*.ts",
    "scripts/**/*.ts"
  ]
}
